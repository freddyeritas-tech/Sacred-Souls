{
  "expo": {
    "name": "Sacred Souls",
    "slug": "sacred-souls",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sacredsouls",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sacredsouls.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Video calls with your spiritual community",
        "NSMicrophoneUsageDescription": "Voice chat during virtual gatherings",
        "NSPhotoLibraryUsageDescription": "Share photos in your circles"
      }
    },
    "android": {
      "package": "com.sacredsouls.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F0A1F"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F0A1F"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "owner": "your-expo-username",
    "description": "Sacred Souls - Conscious Social Network. Connect with spiritual communities, join circles, attend virtual and nature gatherings, and grow on your spiritual journey.",
    "githubUrl": "https://github.com/your-username/sacred-souls",
    "primaryColor": "#7C3AED"
  }
}
